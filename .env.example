# Configuração da alternativa de desenvolvimento: bash iniciar.sh --local
# O Docker Compose usa seu próprio banco demo e não carrega este arquivo.
# Copiado para .env.local sem sobrescrever arquivos existentes. Sintaxe Bash.

SPRING_PROFILES_ACTIVE='demo'
# O perfil demo usa localhost:5432/portal_demo com usuário e senha portal_demo.
# Para iniciar somente o banco, execute:
# docker compose -f compose.yaml -f compose.dev.yaml up -d db

# Para usar outro banco, descomente as três variáveis:
# SPRING_DATASOURCE_URL='jdbc:postgresql://localhost:5432/seu_banco'
# SPRING_DATASOURCE_USERNAME='seu_usuario'
# SPRING_DATASOURCE_PASSWORD='sua_senha'

ABRIR_NAVEGADOR=1
TEMPO_INICIALIZACAO=180
